prefix=${pcfiledir}/../..
includedir=${prefix}/include
libdir=${prefix}/lib
doxygen_tag=${prefix}/doc/meas_astrom.tag
lsst_build_requires=boost_test pybind11 python3

Name: lsst_meas_astrom
Description: LSST Science Pipelines astrometric calibration
Version: @VERSION@
Requires: lsst_geom lsst_sphgeom lsst_afw eigen3 lsst_log
Cflags: -I${includedir}
Libs: -L${libdir} -lmeas_astrom
